# Supabase 대시보드 → Project Settings → API (Data API / API Keys)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role 키 (또는 새 방식의 secret 키). 서버에서만 쓰며 NEXT_PUBLIC_ 을 붙이면 안 됩니다.
SUPABASE_SERVICE_ROLE_KEY=

# 앱 입장 비밀번호 (직접 정하세요)
APP_PASSWORD=

# (선택) 로그인 쿠키 서명용 값. 비워두면 APP_PASSWORD 로 대신합니다.
# AUTH_SECRET=
